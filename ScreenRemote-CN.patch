diff --git a/scripts/build-unsigned-ipa.sh b/scripts/build-unsigned-ipa.sh
new file mode 100644
index 0000000..1bef986
--- /dev/null
+++ b/scripts/build-unsigned-ipa.sh
@@ -0,0 +1,136 @@
+#!/usr/bin/env bash
+#
+# 构建未签名的 Scrcpy Remote IPA。
+#
+# 运行环境：macOS + Xcode 16（iOS 18 SDK）+ Homebrew 工具链。
+# 产物：build/unsigned/Scrcpy-Remote-unsigned.ipa
+#
+# 用法：
+#   bash scripts/build-unsigned-ipa.sh
+#
+# 第一次运行会编译 OpenSSL / libvncclient / libadb / SDL3 / FFmpeg / scrcpy，
+# 大约需要 1.5 - 3 小时，请预留足够时间和磁盘空间（约 15 GB）。
+#
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+cd "$ROOT"
+
+BUILD_DIR="$ROOT/build/unsigned"
+ARCHIVE="$BUILD_DIR/ScrcpyRemote.xcarchive"
+APP_NAME="Scrcpy Remote.app"
+IPA="$BUILD_DIR/Scrcpy-Remote-unsigned.ipa"
+
+log() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
+fail() { printf '\n\033[1;31m错误：%s\033[0m\n' "$*" >&2; exit 1; }
+
+for cmd in git make cmake ninja meson pkg-config protoc go xcodebuild zip ditto curl; do
+    command -v "$cmd" >/dev/null 2>&1 || fail "缺少命令：$cmd"
+done
+
+if ! command -v gas-preprocessor.pl >/dev/null 2>&1; then
+    log "下载 gas-preprocessor.pl（FFmpeg 交叉编译需要）"
+    mkdir -p "$ROOT/build/tools"
+    curl -fsSL https://raw.githubusercontent.com/FFmpeg/gas-preprocessor/master/gas-preprocessor.pl \
+        -o "$ROOT/build/tools/gas-preprocessor.pl"
+    chmod +x "$ROOT/build/tools/gas-preprocessor.pl"
+    export PATH="$ROOT/build/tools:$PATH"
+fi
+
+# adb-mobile 的 Makefile 会往这些目录里拷贝静态库，先建好。
+mkdir -p \
+    porting/libs/iphoneos/arm64 \
+    porting/libs/iphonesimulator/arm64 \
+    porting/libs/iphonesimulator/x86_64 \
+    porting/libs/include
+
+NATIVE_READY=1
+for native_lib in \
+    porting/libs/iphoneos/arm64/libadb-full.a \
+    porting/libs/iphoneos/arm64/libscrcpy.a \
+    porting/libs/iphoneos/arm64/libSDL3.a \
+    porting/libs/iphoneos/arm64/libavformat.a \
+    porting/libs/iphoneos/arm64/libvncclient.a \
+    porting/libs/iphoneos/arm64/libtsnet-forwarder.a; do
+    [ -f "$native_lib" ] || NATIVE_READY=0
+done
+
+if [ "$NATIVE_READY" = "1" ]; then
+    log "检测到已缓存的依赖库，跳过原生编译"
+else
+    log "[1/8] 初始化子模块（首次约 5-10 分钟）"
+    git submodule update --init --recursive
+
+    # adb-mobile 的 CMake 配置需要能正常运行的 protoc 和 Protobuf 的
+    # CMake 包。官方 protoc 在 /tmp/protoc/bin，Homebrew 只提供 host
+    # 的 libprotobuf/CMake 配置。把这个路径显式传给 adb 的 CMake。
+    ADB_DEFINES="external/adb-mobile/porting/scripts/defines.sh"
+    if [ -f "$ADB_DEFINES" ]; then
+        BREW_PREFIX="$(brew --prefix)"
+        printf '\nCMAKE_COMPAT_FLAGS="$CMAKE_COMPAT_FLAGS -DCMAKE_PREFIX_PATH=%s -DProtobuf_PROTOC_EXECUTABLE=/tmp/protoc/bin/protoc"\n' \
+            "$BREW_PREFIX" >> "$ADB_DEFINES"
+    fi
+
+    log "[2/8] 编译 OpenSSL"
+    make -C porting openssl
+
+    log "[3/8] 编译 libvncclient"
+    make -C porting vncclient
+
+    log "[4/8] 编译 libadb（首次约 15-25 分钟）"
+    make -C porting adb-mobile
+
+    log "[5/8] 编译 SDL3"
+    make -C porting libsdl
+
+    log "[6/8] 编译 FFmpeg（首次约 30-50 分钟）"
+    make -C porting ffmpeg
+
+    # make-ffmpeg.sh 只把 .a / include 拷进 porting/libs，没有带 pkg-config 文件；
+    # scrcpy 的 meson 配置会报 "Dependency libavformat not found"。这里补上。
+    log "复制 FFmpeg pkg-config 文件（scrcpy meson 配置需要）"
+    mkdir -p porting/libs/lib/pkgconfig
+    for ff_prefix in \
+        porting/build/ffmpeg/iphoneos-arm64 \
+        porting/build/ffmpeg/iphonesimulator-arm64 \
+        porting/build/ffmpeg/iphonesimulator-x86_64; do
+        if [ -d "$ff_prefix/lib/pkgconfig" ]; then
+            cp -f "$ff_prefix"/lib/pkgconfig/*.pc porting/libs/lib/pkgconfig/ 2>/dev/null || true
+        fi
+    done
+
+    log "[7/8] 编译 scrcpy 静态库"
+    make -C porting scrcpy
+
+    log "[8/8] 编译 Tailscale tsnet"
+    make -C porting tsnet-forwarder
+fi
+
+log "归档（关闭签名）"
+rm -rf "$ARCHIVE" "$BUILD_DIR/Payload" "$IPA"
+mkdir -p "$BUILD_DIR"
+
+xcodebuild \
+    -project "scrcpy-app/Scrcpy Remote.xcodeproj" \
+    -scheme "Scrcpy Remote" \
+    -configuration Release \
+    -sdk iphoneos \
+    -destination "generic/platform=iOS" \
+    -archivePath "$ARCHIVE" \
+    archive \
+    CODE_SIGNING_ALLOWED=NO \
+    CODE_SIGNING_REQUIRED=NO \
+    CODE_SIGN_IDENTITY="" \
+    DEVELOPMENT_TEAM="" \
+    ENABLE_BITCODE=NO
+
+APP="$ARCHIVE/Products/Applications/$APP_NAME"
+[[ -d "$APP" ]] || fail "归档里找不到 $APP"
+
+log "打包未签名 IPA"
+mkdir -p "$BUILD_DIR/Payload"
+ditto "$APP" "$BUILD_DIR/Payload/$APP_NAME"
+(cd "$BUILD_DIR" && zip -qry "$(basename "$IPA")" Payload)
+
+log "完成：$IPA"
+echo "把 IPA 用 Sideloadly / AltStore / esign 等工具用自己的证书签名后即可安装。"
