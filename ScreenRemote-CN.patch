+
+// MARK: - Live Preview
+
+/// Captures the latest decoded video frame into a small image so the Sessions
+/// screen can show a live preview of the connected device.
+///
+/// Frames arrive on scrcpy's decoder thread. Conversion is throttled and runs
+/// on a private serial queue; only the finished `UIImage` is published on the
+/// main thread, so SwiftUI never touches a `CVPixelBuffer`.
+@objc(ScrcpyPreviewManager)
+final class ScrcpyPreviewManager: NSObject, ObservableObject {
+    @objc static let shared = ScrcpyPreviewManager()
+
+    /// Latest preview frame. Always published on the main thread.
+    @Published private(set) var image: UIImage?
+
+    /// Whether frames should be captured. Only true while the live mirror is
+    /// minimised to the Sessions screen, so the full-screen mirror pays nothing
+    /// for this feature.
+    @objc var isActive: Bool {
+        get {
+            lock.lock()
+            defer { lock.unlock() }
+            return _isActive
+        }
+        set {
+            lock.lock()
+            _isActive = newValue
+            lock.unlock()
+            if !newValue {
+                clear()
+            }
+        }
+    }
+
+    private let lock = NSLock()
+    private var _isActive = false
+    private var lastCaptureTime: CFTimeInterval = 0
+
+    private override init() {
+        super.init()
+        // ScrcpyCommon.m is shared with the VNCClient framework target and
+        // cannot import the app's generated Swift header, so it tells us about
+        // minimise/restore through a notification instead.
+        NotificationCenter.default.addObserver(
+            forName: Notification.Name("ScrcpyMirrorMinimizedChanged"),
+            object: nil,
+            queue: .main
+        ) { [weak self] note in
+            guard let self = self else { return }
+            self.isActive = (note.userInfo?["minimized"] as? Bool) ?? false
+        }
+    }
+
+    /// Called from the decoder thread for every hardware-decoded frame.
+    ///
+    /// The conversion is done synchronously, while the decoder still owns the
+    /// pixel buffer. Copying it to another queue would require retaining a
+    /// buffer whose lifetime belongs to the AVFrame.
+    @objc func capturePixelBuffer(_ pixelBuffer: CVPixelBuffer) {
+        guard isActive else { return }
+
+        let now = CACurrentMediaTime()
+        lock.lock()
+        let due = (now - lastCaptureTime) >= 0.25   // at most 4 fps
+        if due {
+            lastCaptureTime = now
+        }
+        lock.unlock()
+        guard due else { return }
+
+        guard let image = Self.makeImage(from: pixelBuffer) else { return }
+        DispatchQueue.main.async { [weak self] in
+            guard let self = self, self.isActive else { return }
+            self.image = image
+        }
+    }
+
+    /// Stops capture and drops the current preview (called on disconnect).
+    @objc func reset() {
+        isActive = false
+        clear()
+    }
+
+    private func clear() {
+        DispatchQueue.main.async { [weak self] in
+            guard let self = self else { return }
+            if self.image != nil {
+                self.image = nil
+            }
+        }
+    }
+
+    private static func makeImage(from pixelBuffer: CVPixelBuffer) -> UIImage? {
+        var fullImage: CGImage?
+        let status = VTCreateCGImageFromCVPixelBuffer(pixelBuffer, options: nil, imageOut: &fullImage)
+        guard status == noErr, let full = fullImage else { return nil }
+
+        // Downscale before handing the frame to SwiftUI: a 110pt-tall card does
+        // not need a full 1080p+ frame every tick.
+        let width = CGFloat(full.width)
+        let height = CGFloat(full.height)
+        guard width > 0, height > 0 else { return nil }
+
+        let maxDimension: CGFloat = 480
+        let scale = min(1, maxDimension / max(width, height))
+        let targetWidth = max(1, Int((width * scale).rounded()))
+        let targetHeight = max(1, Int((height * scale).rounded()))
+
+        guard let context = CGContext(
+            data: nil,
+            width: targetWidth,
+            height: targetHeight,
+            bitsPerComponent: 8,
+            bytesPerRow: 0,
+            space: CGColorSpaceCreateDeviceRGB(),
+            bitmapInfo: CGImageAlphaInfo.premultipliedFirst.rawValue | CGBitmapInfo.byteOrder32Little.rawValue
+        ) else { return nil }
+
+        context.interpolationQuality = .medium
+        context.draw(full, in: CGRect(x: 0, y: 0, width: targetWidth, height: targetHeight))
+        guard let scaled = context.makeImage() else { return nil }
+        return UIImage(cgImage: scaled)
+    }
+}
