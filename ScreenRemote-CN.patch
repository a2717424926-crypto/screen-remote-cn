+# Keep shell scripts and CI definitions LF even when the repo is checked out on
+# Windows, otherwise macOS runners fail with "bad interpreter: /bin/bash^M".
+*.sh text eol=lf
+*.yml text eol=lf
+*.yaml text eol=lf
+Makefile text eol=lf
+
+# UTF-16BE localization files must stay byte-for-byte untouched.
+*.strings -text
+*.pbxproj -text
diff --git a/.github/workflows/build-ipa.yml b/.github/workflows/build-ipa.yml
new file mode 100644
index 0000000..cb320d1
--- /dev/null
+++ b/.github/workflows/build-ipa.yml
@@ -0,0 +1,46 @@
+name: Build unsigned IPA
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [ main, master ]
+
+jobs:
+  build:
+    name: Build Scrcpy Remote (unsigned)
+    runs-on: macos-15
+    timeout-minutes: 360
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          submodules: recursive
+          fetch-depth: 1
+
+      - name: Select newest Xcode
+        run: |
+          latest="$(ls -d /Applications/Xcode*.app | sort -V | tail -n 1)"
+          echo "Using $latest"
+          sudo xcode-select -s "$latest/Contents/Developer"
+          xcodebuild -version
+          xcrun --sdk iphoneos --show-sdk-version
+
+      - name: Install build tools
+        run: |
+          brew install cmake ninja meson pkg-config go fmt googletest
+          # adb-mobile 严格要求 protobuf 28.3；brew 默认版本太新会直接报错。
+          brew unlink protobuf || true
+          brew install ./external/adb-mobile/porting/protobuf.rb
+          protoc --version
+
+      - name: Build dependencies and archive
+        run: bash scripts/build-unsigned-ipa.sh
+
+      - name: Upload unsigned IPA
+        uses: actions/upload-artifact@v4
+        with:
+          name: Scrcpy-Remote-unsigned-ipa
+          path: build/unsigned/Scrcpy-Remote-unsigned.ipa
+          if-no-files-found: error
+          retention-days: 30
