diff --git a/scrcpy-app/Scrcpy Remote/ScrcpyCommon.m b/scrcpy-app/Scrcpy Remote/ScrcpyCommon.m
index f7eb737..ce97df3 100644
--- a/scrcpy-app/Scrcpy Remote/ScrcpyCommon.m	
+++ b/scrcpy-app/Scrcpy Remote/ScrcpyCommon.m	
@@ -7,6 +7,109 @@
 
 #import "ScrcpyCommon.h"
 #import <Foundation/Foundation.h>
+#import <UIKit/UIKit.h>
+
+#pragma mark - Mirror Window
+
+// SDL3 hosts every SDL window in a UIWindow whose root view controller is an
+// SDL_uikitviewcontroller. Matching on the class name keeps this helper free of
+// SDL private headers and works for both ADB and VNC sessions.
+static BOOL ScrcpyClassLooksLikeSDL(NSString *className) {
+    return [className containsString:@"SDL_uikitviewcontroller"]
+        || [className containsString:@"SDL_uikitview"];
+}
+
+UIWindow *ScrcpyFindMirrorWindow(void) {
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            continue;
+        }
+        UIWindowScene *windowScene = (UIWindowScene *)scene;
+        for (UIWindow *window in windowScene.windows) {
+            NSString *className = NSStringFromClass(window.rootViewController.class);
+            if (ScrcpyClassLooksLikeSDL(className)) {
+                return window;
+            }
+        }
+    }
+    return nil;
+}
+
+static UIWindow *ScrcpyFindHostAppWindow(void) {
+    UIWindow *fallback = nil;
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            continue;
+        }
+        UIWindowScene *windowScene = (UIWindowScene *)scene;
+        for (UIWindow *window in windowScene.windows) {
+            NSString *className = NSStringFromClass(window.rootViewController.class);
+            if (ScrcpyClassLooksLikeSDL(className)) {
+                continue;
+            }
+            // Prefer the SwiftUI host window over keyboard/overlay windows.
+            if ([className containsString:@"UIHostingController"]) {
+                return window;
+            }
+            if (!fallback) {
+                fallback = window;
+            }
+        }
+    }
+    return fallback ?: UIApplication.sharedApplication.keyWindow;
+}
+
+// A level below UIWindowLevelNormal keeps the mirror alive and rendering
+// behind the opaque SwiftUI window. Hiding it outright makes
+// AVSampleBufferDisplayLayer stop draining, which stalls the decoder and can
+// leave the full-screen picture black for a moment when it is restored.
+static const UIWindowLevel kScrcpyMirrorMinimizedLevel = -1.0;
+
+static void ScrcpyApplyMirrorWindowMinimized(BOOL minimized) {
+    UIWindow *mirrorWindow = ScrcpyFindMirrorWindow();
+    UIWindow *appWindow = ScrcpyFindHostAppWindow();
+
+    // This file is compiled into both the app and the VNCClient framework, and
+    // only the app has the generated Swift header. Use a notification so the
+    // shared Objective-C file never has to import Scrcpy_Remote-Swift.h.
+    // ScrcpyPreviewManager observes it and enables capture only while the
+    // Sessions screen is showing the preview.
+    [[NSNotificationCenter defaultCenter]
+        postNotificationName:@"ScrcpyMirrorMinimizedChanged"
+                      object:nil
+                    userInfo:@{@"minimized": @(minimized)}];
+
+    if (minimized) {
+        // Promote the SwiftUI window first so the app never ends up with a
+        // key window that sits below another one.
+        [appWindow makeKeyAndVisible];
+        mirrorWindow.windowLevel = kScrcpyMirrorMinimizedLevel;
+        NSLog(@"🗕 [ScrcpyCommon] Mirror window minimised (app window key)");
+    } else {
+        if (!mirrorWindow) {
+            NSLog(@"⚠️ [ScrcpyCommon] Cannot restore mirror: window not found");
+            return;
+        }
+        mirrorWindow.windowLevel = UIWindowLevelNormal;
+        [mirrorWindow makeKeyAndVisible];
+        NSLog(@"⤢ [ScrcpyCommon] Mirror window restored");
+    }
+}
+
+void ScrcpySetMirrorWindowMinimized(BOOL minimized) {
+    if (NSThread.isMainThread) {
+        ScrcpyApplyMirrorWindowMinimized(minimized);
+    } else {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            ScrcpyApplyMirrorWindowMinimized(minimized);
+        });
+    }
+}
+
+BOOL ScrcpyIsMirrorWindowMinimized(void) {
+    UIWindow *mirrorWindow = ScrcpyFindMirrorWindow();
+    return mirrorWindow ? (mirrorWindow.windowLevel < UIWindowLevelNormal) : NO;
+}
 
